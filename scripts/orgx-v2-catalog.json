  "check_execution_readiness": "orgx_check_execution_readiness",
  "orgx_submit_receipt": "no v2 operation: put quality in orgx_complete_work_with_proof (quality_score, verification) and learnings in its note; import portable receipts with orgx_submit_work_receipt",
  "orgx_emit_activity": "no v2 operation: progress is captured by client hooks; record outcomes with orgx_complete_work_with_proof",
  "orgx_apply_changeset": "no v2 operation: use the typed create/update operations"
